{
  "root": "VContainer",
  "components": {
    "VContainer": {
      "signature": "VContainer(children: (LineChart | BarChart | PieChart | ScatterChart | Heatmap | Waterfall | Kpi | Table | Matrix | Slicer | Insight | Unsupported | HContainer | Tabs | Section)[])",
      "description": "Vertical stack of tiles/containers. Use as root."
    },
    "HContainer": {
      "signature": "HContainer(children: (LineChart | BarChart | PieChart | ScatterChart | Heatmap | Waterfall | Kpi | Table | Matrix | Slicer | Insight | Unsupported | any | any)[], weights?: number[])",
      "description": "Horizontal row of tiles/containers. weights = relative widths (same length as children), default equal."
    },
    "Section": {
      "signature": "Section(title: string, children: (LineChart | BarChart | PieChart | ScatterChart | Heatmap | Waterfall | Kpi | Table | Matrix | Slicer | Insight | Unsupported | HContainer | Tabs | any)[], subtitle?: string)",
      "description": "Titled group of tiles/containers stacked vertically."
    },
    "Tabs": {
      "signature": "Tabs(labels: string[], children: (LineChart | BarChart | PieChart | ScatterChart | Heatmap | Waterfall | Kpi | Table | Matrix | Slicer | Insight | Unsupported | HContainer | any)[])",
      "description": "Tabbed views; labels[i] is the tab title of children[i]."
    },
    "LineChart": {
      "signature": "LineChart(title: string, data: any, x: string, y: string[], options?: {crossFilter?: string, subtitle?: string, area?: boolean, smooth?: boolean})",
      "description": "Trend over an ordered dimension (usually time). One line per y column."
    },
    "BarChart": {
      "signature": "BarChart(title: string, data: any, x: string, y: string[], options?: {crossFilter?: string, subtitle?: string, stack?: boolean, horizontal?: boolean, lines?: string[]})",
      "description": "Compare a measure across categories. stack=true stacks series; horizontal=true for long labels; lines turns listed y columns into lines (combo)."
    },
    "PieChart": {
      "signature": "PieChart(title: string, data: any, category: string, value: string, options?: {crossFilter?: string, subtitle?: string, donut?: boolean})",
      "description": "Part-of-whole for at most 8 categories."
    },
    "ScatterChart": {
      "signature": "ScatterChart(title: string, data: any, x: string, y: string, options?: {crossFilter?: string, subtitle?: string, series?: string})",
      "description": "Relationship between two measures; optional series column for colour."
    },
    "Heatmap": {
      "signature": "Heatmap(title: string, data: any, x: string, y: string, value: string, options?: {crossFilter?: string, subtitle?: string})",
      "description": "Measure intensity across two dimensions."
    },
    "Waterfall": {
      "signature": "Waterfall(title: string, data: any, category: string, value: string, options?: {crossFilter?: string, subtitle?: string})",
      "description": "Bridge from a start value through positive/negative contributions (in row order)."
    },
    "Kpi": {
      "signature": "Kpi(title: string, data: any)",
      "description": "Headline number with optional comparison; data MUST be a Query(\"render_kpi\", ...)."
    },
    "Table": {
      "signature": "Table(title: string, data: any, columns?: string[])",
      "description": "Detail rows; columns limits and orders the shown columns."
    },
    "Matrix": {
      "signature": "Matrix(title: string, data: any, rows: string, columns: string, value: string)",
      "description": "Pivot: rows x columns with one aggregated value per cell."
    },
    "Slicer": {
      "signature": "Slicer(title: string, column: string, mode: \"in\" | \"date_range\", data?: any)",
      "description": "Canvas filter tile writing the dashboard Global_Filter. mode \"in\" lists distinct values from data; \"date_range\" picks a range."
    },
    "Insight": {
      "signature": "Insight(type: \"trend\" | \"anomaly\" | \"comparison\" | \"top_bottom_contributors\" | \"cross_dataset_correlation\", title: string, text: string, query: string)",
      "description": "Narrative finding. Every number in text must come from the query result; backend verifies it."
    },
    "Unsupported": {
      "signature": "Unsupported(title: string, reason: string)",
      "description": "System placeholder for migrated items that could not be converted. Do not write."
    }
  },
  "componentGroups": [
    {
      "name": "Layout",
