# Salin ke backend/.env lalu sesuaikan.

# Server. Default bind ke loopback; host non-loopback memicu peringatan
# karena API tidak memiliki autentikasi.
HOST=127.0.0.1
PORT=8000

# Direktori data lokal (SQLite + uploads). Kosongkan untuk default <repo>/data.
DATA_DIR=

# Metadata_Store + sesi ADK. Kosong = SQLite di DATA_DIR. Postgres: jalankan
# `docker compose up -d` lalu `alembic upgrade head` di folder backend.
# DATABASE_URL=postgresql://studio:studio@127.0.0.1:5434/dashboard_studio
DATABASE_URL=

# Origin frontend yang diizinkan CORS (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:3000

# Opsi runtime opsional (kosongkan untuk default).
# Timeout eksekusi query dalam detik (default 60).
QUERY_TIMEOUT_S=
# Jumlah proses query worker (default: otomatis dari jumlah CPU).
QUERY_WORKERS=
# "process" (default, worker terpisah) atau "inline" (thread; untuk test).
QUERY_RUNNER_MODE=
# Batas ukuran file upload dalam byte (default & minimum 1073741824 = 1 GiB).
MAX_UPLOAD_BYTES=
# Interval heartbeat SSE dalam detik (default 15).
SSE_HEARTBEAT_SECONDS=

# Model LLM (format LiteLLM, mis. gemini/gemini-2.5-flash, openai/gpt-4o-mini).
# Variabel per agent yang kosong akan memakai MODEL_DEFAULT.
MODEL_DEFAULT=gemini/gemini-2.5-flash
MODEL_ROOT=
MODEL_PROFILER=
MODEL_QUERY=
MODEL_CHART=
MODEL_INSIGHT=
# Dashboard_Architect_Agent (perancang dashboard BI).
MODEL_ARCHITECT=
# Semantic_Drafter (draft model semantik otomatis; tanpa tool calling).
MODEL_SEMANTIC=
# Anggaran karakter konteks semantik per agent (default 12000) dan
# batas waktu draft semantik LLM dalam detik (default 60).
SEMANTIC_CONTEXT_BUDGET=
SEMANTIC_DRAFT_TIMEOUT_S=

# Kredensial provider dibaca langsung oleh LiteLLM, mis.:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
